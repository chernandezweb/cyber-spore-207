{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CYBER-SPORE 207",
  "version": "0.2.7",
  "identifier": "com.studio207.cyberspore207",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5207",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CYBER-SPORE 207 // NEON KINGDOM",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
